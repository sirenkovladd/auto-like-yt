{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "author": "R.LUIZ + Vlad",
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "js": [
            "content.js"
         ],
         "matches": [
            "https://www.youtube.com/*"
         ]
      }
   ],
   "default_locale": "en",
   "description": "__MSG_extDescription__",
   "host_permissions": [
      "https://www.youtube.com/*"
   ],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "permissions": [
      "activeTab",
      "storage",
      "alarms",
      "tabs",
      "scripting"
   ],
   "version": "2.0.1"
}